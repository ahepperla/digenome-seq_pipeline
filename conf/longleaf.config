/*
 * UNC Longleaf: SLURM with Apptainer images from this checkout's containers/.
 */

process {
    executor = 'slurm'
    resourceLimits = [cpus: 256, memory: 3041.GB, time: 240.h]
}

executor {
    queueGlobalStatus = true
}

apptainer {
    enabled = true
    autoMounts = true
    // The FASTA and the reference cache are read and written by path, so
    // their filesystems must be visible inside the containers.
    runOptions = '--bind /proj --bind /work --bind /users --bind /overflow --bind /nas'
}
