/*
 * Resources and container images for every profile. Profiles may cap
 * requests with process.resourceLimits. Retries after a kill or time limit
 * ask for more memory and time.
 */

process {
    shell = ['/bin/bash', '-euo', 'pipefail']
    errorStrategy = { task.exitStatus in [130, 137, 140, 143] ? 'retry' : 'terminate' }
    maxRetries = 1

    withName: SAMPLESHEET {
        container = "${projectDir}/containers/cleavage_pysam_v0.23.3.sif"
        cpus = 1
        memory = 1.GB
        time = 15.min
    }
    withName: PREPARE_INDEX {
        container = "${projectDir}/containers/bwa-mem2_v2.3_samtools_v1.22.sif"
        cpus = 12
        memory = 100.GB
        time = 24.h
    }
    withName: FASTP {
        container = "${projectDir}/containers/fastp_v1.3.3.sif"
        cpus = 4
        memory = { 20.GB * task.attempt }
        time = { 12.h * task.attempt }
    }
    withName: ALIGN {
        container = "${projectDir}/containers/bwa-mem2_v2.3_samtools_v1.22.sif"
        cpus = 16
        memory = { 64.GB * task.attempt }
        time = { 48.h * task.attempt }
    }
    withName: SORT_BAM {
        container = "${projectDir}/containers/bwa-mem2_v2.3_samtools_v1.22.sif"
        cpus = 8
        memory = { 32.GB * task.attempt }
        time = { 12.h * task.attempt }
    }
    withName: CALL_CHUNK {
        container = "${projectDir}/containers/cleavage_pysam_v0.23.3.sif"
        cpus = 1
        memory = { 16.GB * task.attempt }
        time = { 48.h * task.attempt }
    }
    withName: FINALIZE {
        container = "${projectDir}/containers/cleavage_pysam_v0.23.3.sif"
        cpus = 1
        memory = { 16.GB * task.attempt }
        time = { 12.h * task.attempt }
    }
    withName: MULTIQC {
        container = "${projectDir}/containers/multiqc_v1.35.sif"
        cpus = 2
        memory = 8.GB
        time = 2.h
    }
}

report {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/nextflow_report.html"
}

timeline {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/timeline.html"
}

trace {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/trace.txt"
}

dag {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/dag.html"
}
