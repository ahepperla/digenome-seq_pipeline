/*
 * Tiny synthetic run. Build the inputs first:
 *   python3 tests/fixtures/build_smoke_fixture.py
 * Combine with apptainer (local) or longleaf (SLURM), listing test last:
 *   nextflow run . -profile apptainer,test --analysis ndigenome --outdir smoke_results
 */

params {
    input = "${projectDir}/tests/fixtures/generated/samplesheet.csv"
    genome = 'tiny'
    genomes = [tiny: [fasta: "${projectDir}/tests/fixtures/tiny.fa"]]
    ref_cache = "${projectDir}/tests/fixtures/generated/reference_cache"
    cleavage_chunks = 3
}

process {
    resourceLimits = [cpus: 2, memory: 4.GB, time: 1.h]
}
