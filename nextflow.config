/*
 * Digenome-seq / nDigenome-seq pipeline configuration.
 *
 * Parameter types, ranges, and descriptions live in nextflow_schema.json and
 * are checked at launch; docs/parameters.md explains each one.
 */

manifest {
    name = 'digenome-seq-pipeline'
    description = 'Digenome-seq (DSB) and nDigenome-seq (SSB) cleavage calling from Illumina WGS or aligned long reads'
    nextflowVersion = '>=25.04.0'
}

plugins {
    // 2.5.x is the last nf-schema line that supports Nextflow 25.04 (Longleaf).
    id 'nf-schema@2.5.1'
}

params {
    input = null
    genome = null
    analysis = 'digenome'
    outdir = 'results'
    genome_blacklist = null
    ref_cache = "${projectDir}/reference_cache"
    keep_multimappers = false
    long_reads = false
    cleavage_chunks = 8
    publish_trimmed_fastqs = false

    // --genome takes a name or any of its aliases, in any case.
    genomes = [
        GRCh38: [
            fasta: '/proj/seq/data/GRCh38_GENCODE/GRCh38.primary_assembly.genome.fa',
            aliases: ['hg38', 'human_hg38'],
        ],
        GRCh37: [
            fasta: '/proj/seq/data/HG19_UCSC/Sequence/WholeGenomeFasta/genome.fa',
            aliases: ['hg19', 'human_hg19'],
        ],
        GRCm39: [
            fasta: '/proj/seq/data/GRCm39_GENCODE/Sequence/WholeGenomeFasta/GRCm39.primary_assembly.genome.fa',
            aliases: ['mm39', 'mouse_mm39'],
        ],
    ]

    fastp_qualified_quality_phred = 20
    fastp_length_required = 30
    fastp_low_complexity_filter = true
    fastp_complexity_threshold = 30
    fastp_extra_args = ''

    // Count, depth, and fraction defaults from `digenome -f 5 -r 5 -d 10 -R 0.2`.
    // The pair-score cutoff is RGEN's -s 2.5 moved to this score's scale
    // (docs/decisions.md, 2026-10-07).
    digenome_overhang = 0
    digenome_pair_window = 2
    digenome_min_mapq = 1
    digenome_forward_cutoff = 5
    digenome_reverse_cutoff = 5
    digenome_depth_cutoff = 10
    digenome_fraction_cutoff = 0.20
    digenome_pair_score_cutoff = 1.1

    // Focal count and fraction from Kim et al. 2020 (doi:10.1093/nar/gkaa764);
    // the rest are pipeline defaults.
    ndigenome_min_count = 10
    ndigenome_min_fraction = 0.20
    ndigenome_min_mapq = 1
    ndigenome_opposite_window = 5
    ndigenome_ambiguous_min_count = 3
    ndigenome_ambiguous_min_fraction = 0.05

    cleavage_artifact_window = 10
    cleavage_max_softclip_fraction = 0.20
    cleavage_max_indel_fraction = 0.20
    cleavage_min_support_mean_mapq = 10
    cleavage_control_min_depth = 1
    cleavage_control_max_fraction = 0.05
    cleavage_control_min_fold = 5.0
    cleavage_control_max_q = 0.05
}

validation {
    // params.genomes is configuration (name -> [fasta: path]), not a CLI option.
    ignoreParams = ['genomes']
    logging {
        unrecognisedParams = 'error'
    }
    help {
        enabled = true
        command = 'nextflow run <pipeline> -profile longleaf --input samplesheet.csv --genome GRCh38 --analysis digenome'
    }
}

includeConfig 'conf/base.config'

profiles {
    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
    }
    slurm {
        process.executor = 'slurm'
        executor.queueGlobalStatus = true
    }
    longleaf {
        includeConfig 'conf/longleaf.config'
    }
    test {
        includeConfig 'conf/test.config'
    }
}
