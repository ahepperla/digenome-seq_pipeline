/*
 * Digenome-seq / nDigenome-seq pipeline configuration.
 *
 * Project-relative defaults make the checkout portable. The Longleaf profile
 * supplies UNC site paths and SLURM/Apptainer execution settings.
 */

params {
    max_memory = 3041.GB
    max_cpus   = 256
    max_time   = 240.h

    input    = null
    outdir   = 'results'
    genome   = null
    analysis = 'digenome'

    container_bind_paths = []

    // Content-addressed bwa-mem2 index cache.
    ref_cache = "${projectDir}/reference_cache"
    index_lock_timeout_seconds = 172800
    index_stale_lock_seconds = 172800

    genomes = [
        GRCh38: [
            fasta: '/proj/seq/data/GRCh38_GENCODE/GRCh38.primary_assembly.genome.fa',
            aliases: ['hg38', 'human_hg38']
        ],
        GRCh37: [
            fasta: '/proj/seq/data/HG19_UCSC/Sequence/WholeGenomeFasta/genome.fa',
            aliases: ['hg19', 'human_hg19']
        ],
        GRCm39: [
            fasta: '/proj/seq/data/GRCm39_GENCODE/Sequence/WholeGenomeFasta/GRCm39.primary_assembly.genome.fa',
            aliases: ['mm39', 'mouse_mm39']
        ]
    ]

    keep_multimappers = false

    // Parallel interval-based cleavage callers. Each chunk requests one CPU.
    cleavage_chunks = 8

    fastp_qualified_quality_phred = 20
    fastp_length_required = 30
    fastp_low_complexity_filter = true
    fastp_complexity_threshold = 30
    fastp_extra_args = ''

    publish_concat_fastqs = false
    publish_trimmed_fastqs = false

    // Digenome DSB pairing and score thresholds.
    digenome_overhang = 0
    digenome_pair_window = 2
    digenome_min_mapq = 1
    digenome_forward_cutoff = 5
    digenome_reverse_cutoff = 5
    digenome_depth_cutoff = 10
    digenome_fraction_cutoff = 0.20
    digenome_score_cutoff = 2.5

    // Focal count/fraction are from Kim et al. 2020 (doi:10.1093/nar/gkaa764).
    // MAPQ and opposite-strand ambiguity settings are pipeline defaults.
    ndigenome_min_count = 10
    ndigenome_min_fraction = 0.20
    ndigenome_min_mapq = 1
    ndigenome_opposite_window = 5
    ndigenome_ambiguous_min_count = 3
    ndigenome_ambiguous_min_fraction = 0.05

    // Shared DSB/SSB artifact and matched-control filters.
    cleavage_artifact_window = 10
    cleavage_max_softclip_fraction = 0.20
    cleavage_max_indel_fraction = 0.20
    cleavage_min_support_mean_mapq = 10
    cleavage_control_min_depth = 1
    cleavage_control_max_fraction = 0.05
    cleavage_control_min_fold = 5.0
    cleavage_control_max_q = 0.05

    containers = [
        // MultiQC includes Python and is used for the lightweight validator.
        python: "${projectDir}/containers/multiqc_v1.35.sif",
        fastp: "${projectDir}/containers/fastp_v1.3.3.sif",
        align: "${projectDir}/containers/bwa-mem2_v2.3_samtools_v1.22.sif",
        cleavage: "${projectDir}/containers/cleavage_pysam_v0.23.3.sif",
        multiqc: "${projectDir}/containers/multiqc_v1.35.sif"
    ]
}

profiles {
    standard {
        includeConfig 'conf/base.config'
    }

    slurm {
        includeConfig 'conf/base.config'
        includeConfig 'conf/slurm.config'
    }

    apptainer {
        includeConfig 'conf/base.config'
        includeConfig 'conf/apptainer.config'
    }

    longleaf {
        includeConfig 'conf/base.config'
        includeConfig 'conf/slurm.config'
        includeConfig 'conf/apptainer.config'
        includeConfig 'conf/longleaf.config'
    }
}

manifest {
    name = 'digenome-seq-pipeline'
    description = 'Illumina WGS Digenome-seq and strand-specific nDigenome-seq pipeline'
}
