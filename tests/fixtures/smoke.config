params {
    genomes = [
        tiny: [
            fasta: "${projectDir}/tests/fixtures/tiny.fa",
            aliases: []
        ]
    ]
    ref_cache = "${projectDir}/tests/fixtures/reference_cache"
}

// Keep the tiny orchestration fixture runnable on a two-CPU local executor.
// Production resources remain authoritative in conf/base.config.
process {
    withName: VALIDATE_SAMPLESHEET {
        cpus = 1
        memory = '512 MB'
        time = '15 min'
    }

    withName: PREPARE_BWAMEM2_INDEX {
        cpus = 2
        memory = '2 GB'
        time = '1 h'
    }

    withName: CONCAT_PE_FASTQS {
        cpus = 1
        memory = '1 GB'
        time = '30 min'
    }

    withName: CONCAT_SE_FASTQS {
        cpus = 1
        memory = '1 GB'
        time = '30 min'
    }

    withName: FASTP_PE {
        cpus = 2
        memory = '2 GB'
        time = '1 h'
    }

    withName: FASTP_SE {
        cpus = 2
        memory = '2 GB'
        time = '1 h'
    }

    withName: ALIGN_MARKDUP_PE {
        cpus = 2
        memory = '4 GB'
        time = '1 h'
    }

    withName: ALIGN_MARKDUP_SE {
        cpus = 2
        memory = '4 GB'
        time = '1 h'
    }

    withName: PLAN_CLEAVAGE_CHUNKS {
        cpus = 1
        memory = '2 GB'
        time = '1 h'
    }

    withName: CLEAVAGE_CALL_CHUNK {
        cpus = 1
        memory = '2 GB'
        time = '1 h'
    }

    withName: FINALIZE_CLEAVAGE_CALL {
        cpus = 1
        memory = '2 GB'
        time = '1 h'
    }

    withName: MULTIQC {
        cpus = 1
        memory = '2 GB'
        time = '30 min'
    }
}
